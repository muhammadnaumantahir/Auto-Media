rules_version = '2';

// Phase 1 rules: open for local development only.
// Before deploying anywhere public, add real Firebase Auth and replace
// "true" below with a check against request.auth.uid.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;

      match /config/{docId} {
        allow read, write: if true;
      }
      match /connectors/{platform} {
        allow read, write: if true;
      }
    }
  }
}
