# Local server config (server/index.mjs). Copy this file to server/.env.

PORT=8787

# Needed for the server to read AND write your Google Sheet (write-back is
# what marks a row "posted" automatically after a run). Create a service
# account in Google Cloud Console, enable the Sheets API, then either:
#   - paste its email + private key below, or
#   - point GOOGLE_SERVICE_ACCOUNT_KEY_FILE at the downloaded JSON key file
# Then share your Google Sheet with that service account's email as Editor
# — this step is required, the server can't write to a sheet it hasn't
# been given edit access to.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
