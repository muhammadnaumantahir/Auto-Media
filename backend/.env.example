# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_string

# AES key used to encrypt stored OAuth/platform tokens before writing them
# into the master Users sheet. Must be exactly 32 characters.
TOKEN_ENCRYPTION_KEY=change_this_to_32_characters_long

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Master "Users" Google Sheet.
# Create one blank Google Sheet, share it with the service account or your
# own Google account (whichever credential you use), and put its ID here.
# The sheet ID is the long string in the sheet's URL between /d/ and /edit.
MASTER_SHEET_ID=your_master_users_sheet_id

# Google service account (recommended so the app can read/write sheets
# without a human staying logged in). Create one in Google Cloud Console,
# enable the Sheets API, download the JSON key, and paste the two fields
# below. Share your Master Sheet (and ask each user to share their video
# sheet) with this service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
